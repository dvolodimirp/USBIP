#!/bin/sh
# USB/IP mode: export a camera as soon as it is (re)plugged or the bus is re-enumerated
[ "$ACTION" = "add" ] || exit 0
[ "$DEVTYPE" = "usb_interface" ] || exit 0
case "$INTERFACE" in 14/*) ;; *) exit 0 ;; esac
[ "$(uci -q get cams.defaults.usbip)" = "1" ] || exit 0
( sleep 2; /usr/sbin/cams-usbip sync ) >/dev/null 2>&1 &
exit 0
